# Vivado generated (no path prefix, so it matches at any depth)
# mac_zed_project/ itself is tracked (.xpr, .srcs, SDK app code); its build dirs are ignored below
mac_attack_project/
.Xil/
*.cache/
*.runs/
*.sim/
*.hw/
*.gen/
*.ip_user_files/
vivado*.jou
vivado*.log
vivado*.str
webtalk*
*.wdb

# Xilinx SDK / hardware exports
# Keep only the SDK application projects (MAC_*), skip BSPs, hw platforms, workspace metadata
**/*.sdk/*
!**/*.sdk/MAC_*/
**/*.sdk/*_bsp/
**/*.sdk/MAC_*/Debug/
**/*.sdk/MAC_*/Release/
*.hdf
*.bit

# Python
__pycache__/
*.pyc
.venv/
venv/

# Large data
*.wav
data/

# OS
Thumbs.db
