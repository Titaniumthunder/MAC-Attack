@echo off
rem Runs an ARM board program from ..\..\sw against the Tiny-TPU V1 RTL in Vivado's simulator (xsim + DPI-C).
rem Usage (from any folder):  run_xsim_cosim.bat tinytpu_model_test
rem                           run_xsim_cosim.bat tinytpu_test           (the hardware test)
rem Needs only Vivado 2019.1 (set VIVADO_BIN if it is not in C:\Xilinx\Vivado\2019.1\bin).
rem Pass: the program's own last line (ALL ... PASSED) and "[xsim cosim] program returned 0, 0 bus errors".
rem
rem The program is compiled unchanged. Its sources, its headers, the shim and the simulation's xil_io.h /
rem xtime_l.h are copied into the build folder, and a one-line wrapper renames main(): Vivado 2019.1's xsc
rem passes --gcc_compile_options on to its archiver too (so -I breaks the link), a .bat splits -Dx=y at "=", and
rem two C files in one xsc call end in an internal error: so the program and the shim are one file, app_wrap.c.
setlocal
if "%~1"=="" (
  echo Usage: run_xsim_cosim.bat ^<program^>   e.g. tinytpu_model_test, tinytpu_test
  exit /b 2
)
set XC_APP=%~1
if "%VIVADO_BIN%"=="" set VIVADO_BIN=C:\Xilinx\Vivado\2019.1\bin
set XC_HERE=%~dp0
if not exist "%XC_HERE%..\..\sw\%XC_APP%.c" (
  echo No program %XC_HERE%..\..\sw\%XC_APP%.c
  exit /b 2
)
set XC_BUILD=%XC_HERE%build_%XC_APP%
if exist "%XC_BUILD%" rmdir /s /q "%XC_BUILD%"
mkdir "%XC_BUILD%"
copy /y "%XC_HERE%..\..\sw\*.c" "%XC_BUILD%" > nul
copy /y "%XC_HERE%..\..\sw\*.h" "%XC_BUILD%" > nul
copy /y "%XC_HERE%include\*.h" "%XC_BUILD%" > nul
copy /y "%XC_HERE%shim.c" "%XC_BUILD%" > nul
(
  echo /* generated by run_xsim_cosim.bat: the board program with main renamed, for the simulation */
  echo #define main app_main
  echo #define ROUNDS 2
  echo #include "%XC_APP%.c"
  echo #undef main
  echo #include "shim.c"
) > "%XC_BUILD%\app_wrap.c"
pushd "%XC_BUILD%"

rem The C program first (xsc writes its own xsc.log, so its console output goes to c_compile.log), then the RTL
rem (the chip's core file and the ZedBoard wrapper, as the bitstream uses them) and the testbench, then
rem elaborate and run. Each tool in its own cmd, so no settings carry over from one to the next.
cmd /c ""%VIVADO_BIN%\xsc.bat" app_wrap.c" > c_compile.log 2>&1 || goto fail
cmd /c ""%VIVADO_BIN%\xvlog.bat" --nolog ..\..\..\tiny_tpu_axi.v ..\..\..\..\chip\src\tiny_tpu_pe.v" > rtl.log 2>&1 || goto fail
cmd /c ""%VIVADO_BIN%\xvlog.bat" --nolog -sv ..\tb_cosim.sv" > tb.log 2>&1 || goto fail
cmd /c ""%VIVADO_BIN%\xelab.bat" --nolog tb_cosim -sv_lib dpi -s cosim --timescale 1ns/1ps" > elab.log 2>&1 || goto fail
cmd /c ""%VIVADO_BIN%\xsim.bat" cosim -R --nolog"
popd
exit /b 0

:fail
echo Build step failed: see the .log files in %XC_BUILD%
popd
exit /b 1
